# Written by Shopify CLI the first time you run `pnpm dev` / `shopify app dev`
# — you shouldn't need to set these by hand, but they're documented here so
# the full set of required config is in one place.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_orders,read_locations,read_merchant_managed_fulfillment_orders,write_shipping,write_delivery_customizations

# Prisma session storage + HikyakuConnection/HikyakuOAuthState tables.
# Runtime connection, as the least-privilege hikyaku_shopify role (created by
# the least_privilege_role migration; set its password out of band, see there).
# On Supabase's pooler the user is hikyaku_shopify.<project-ref>. On Vercel use
# the transaction pooler (port 6543) so serverless instances don't exhaust
# connections; self-hosted, the direct connection (port 5432) is fine.
# `connection_limit` sets the pool size, and without `sslmode` the connection
# is encrypted but the certificate isn't verified (see app/db.server.ts).
DATABASE_URL=postgresql://hikyaku_shopify.<project-ref>:<password>@<host>:6543/postgres?connection_limit=1
# Direct connection (port 5432) as the privileged postgres role — used only by
# `prisma migrate` (prisma.config.ts).
DIRECT_URL=postgresql://<user>:<password>@<host>:5432/postgres?schema=shopify

HIKYAKU_SUPABASE_URL=https://xxxx.supabase.co
HIKYAKU_SUPABASE_ANON_KEY=sb_publishable_xxxx

# Register this app as a CONFIDENTIAL OAuth client in the Hikyaku Supabase
# project (Dashboard -> Authentication -> OAuth Apps), with
# token_endpoint_auth_method = client_secret_basic and redirect URI
# <SHOPIFY_APP_URL>/hikyaku/callback (exact match, no wildcards — re-register
# whenever the dev tunnel URL changes).
HIKYAKU_OAUTH_CLIENT_ID=
HIKYAKU_OAUTH_CLIENT_SECRET=

# Hikyaku's backend API
HIKYAKU_API_URL=http://localhost:3002

# Optional. The carrier service callback Shopify calls at checkout for Hikyaku
# rates. Defaults to HIKYAKU_API_URL + /api/v1/integrations/shopify/carrier-rates;
# set it in development to a public tunnel to the local hikyaku-api.
HIKYAKU_CARRIER_CALLBACK_URL=

# Shared with hikyaku-api, which signs its change push to /hikyaku/resync with
# it (static Hikyaku rates, HIK-216). Generate a long random value and set the
# same one on hikyaku-api.
HIKYAKU_SHOPIFY_PUSH_SECRET=

# Optional, for testing: forces the path Hikyaku rates take at checkout,
# "live" (carrier service) or "static" (delivery profile rates and the
# Function), whatever the shop's plan allows.
HIKYAKU_RATES_PATH=
